  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 15: Reusable Data Loader\n", "\n", "Implement safe reusable functions for reading CSV, JSON, Parquet."\n ]},
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 15: Reusable data loader\n\ndef load_csv_safe(filepath, **kwargs):\n    \"\"\"Safe CSV loader that doesn't modify source files.\"\"\"\n    import pandas as pd\n    return pd.read_csv(filepath, **kwargs)\n\ndef load_json_safe(filepath):\n    \"\"\"Safe JSON loader.\"\"\"\n    import json\n    with open(filepath, 'r') as f:\n        return json.load(f)\n\ndef load_parquet_safe(filepath):\n    \"\"\"Safe Parquet loader.\"\"\"\n    import pyarrow.parquet as pq\n    return pq.read_table(filepath)\n\ndef infer_format(filepath):\n    \"\"\"Infer file format from extension.\"\"\"\n    ext = os.path.splitext(filepath)[1].lower()\n    if ext == '.csv':\n        return 'csv'\n    elif ext == '.json':\n        return 'json'\n    elif ext == '.parquet':\n        return 'parquet'\n    else:\n        return 'unknown'\n\nprint(\"Data loader functions defined (do not modify source files)\")\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 16: Data Dictionary\n", "\n", "Create data dictionary documentation."\n ]},
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 16: Data dictionary generation\nimport pandas as pd\nimport os\n\ndef generate_data_dictionary():\n    \"\"\"Generate data dictionary for discovered columns.\"\"\"\n    \n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    \n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    import os\n    tum_vars = []\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        tum_vars = dv['variable_name'].tolist()\n    \n    devrt_header = []\n    if devrt_csv:\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            devrt_header = f.readline().strip().split(',')\n    \n    jac_header = []\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            jac_header = f.readline().strip().split(',')\n    \n    # Build dictionary\n    dict_rows = []\n    \n    # DEVRT entries\n    for col in devrt_header:\n        dict_rows.append({\n            'Dataset': 'DEVRT',\n            'Original Column': col,\n            'Standard Concept': col,  # Same name as standard concept for DEVRT\n            'Unit': 'unknown',  # Will be filled based on inspection\n            'Meaning': 'unknown',\n            'Notes': ''\n        })\n    \n    # JAC entries\n    for col in jac_header:\n        dict_rows.append({\n            'Dataset': 'JAC',\n            'Original Column': col,\n            'Standard Concept': col,\n            'Unit': 'unknown',\n            'Meaning': 'unknown',\n            'Notes': ''\n        })\n    \n    # TUM entries (from value_overview)\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        for _, row in dv.iterrows():\n            dict_rows.append({\n                'Dataset': 'TUM',\n                'Original Column': f\"value_id={row['value_id']}\",\n                'Standard Concept': row['variable_name'],\n                'Unit': row['unit'],\n                'Meaning': 'See README for full description',\n                'Notes': f\"min={row['min_val']}, max={row['max_val']}, interval={row['sampling_interval_ms']}ms\"\n            })\n    \n    df_dict = pd.DataFrame(dict_rows)\n    print(f\"Generated {len(df_dict)} dictionary entries\")\n    print(df_dict.head(20).to_string())\n    \n    # Save to docs\n    output_path = \"docs/data_dictionary.md\"\n    df_dict.to_csv(output_path.replace('.md', '.csv'), index=False)\n    print(f\"Saved CSV to {output_path.replace('.md', '.csv')}\")\n\ngenerate_data_dictionary()\n", ""] }
