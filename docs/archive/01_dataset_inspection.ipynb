 "cells": [
  { "cell_type": "markdown", "metadata": {}, "source": ["# EV Intelligence & Dynamic Range Prediction System\n", "\n", "# Dataset Inspection Notebook\n", "\n", "\n", "This notebook programmatically inspects the three real-world EV datasets:\n", "- **DEVRT**: Dacia Spring/Nissan Leaf telemetry from French Basque region\n", "- **JAC IEV40**: Single vehicle telemetry dataset\n", "- **TUM EV UDS**: VW ID.3 and CUPRA Born fleet data collected via UDS\n", "\n", "***NOTE**: Raw data is NOT modified. Only metadata inspection and statistics."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Import required libraries\nimport os\nimport csv\nimport json\nimport pandas as pd\nimport numpy as np\n\nprint(\"Libraries loaded successfully\")\n\n# Base path\nBASE = \"dataset\"\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 1: Discover Dataset Structure\n", "\n", "Recursively inspect all folders and files under `dataset/`."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 1: Recursive file inventory\nimport collections\n\ndef inventory_files(base_path):\n    \"\"\"Recursively inventory all files under base_path.\"\"\"\n    inventory = []\n    for root, dirs, files in os.walk(base_path):\n        for fname in sorted(files):\n            fpath = os.path.join(root, fname)\n            rel_path = os.path.relpath(fpath, base_path)\n            ext = os.path.splitext(fname)[1].lower()\n            \n            # Get file size\n            try:\n                fsize = os.path.getsize(fpath)\n            except OSError:\n                fsize = 0\n            \n            # Categorize file type\n            is_doc = any(kw in fname.lower() for kw in ['readme', 'license', 'reference', 'user guide'])\n            is_csv = ext == '.csv'\n            is_json = ext == '.json'\n            is_parquet = ext == '.parquet'\n            is_geojson = ext in ['.geojson', '.json'] and 'geojson' in root.lower()\n            is_py = ext == '.py'\n            is_md = ext == '.md'\n            \n            inventory.append({\n                'path': rel_path,\n                'filename': fname,\n                'extension': ext,\n                'size': fsize,\n                'is_documentation': is_doc,\n                'is_data_csv': is_csv,\n                'is_data_json': is_json,\n                'is_data_parquet': is_parquet,\n                'is_geojson': is_geojson,\n                'is_code': is_py,\n                'is_md': is_md,\n            })\n    \n    return inventory\n\n# Inventory all datasets\nall_inventory = {}\nfor sub in ['DEVRT - DEVRT', 'archive', 'electric-vehicle-uds-dataset-main']:\n    path = os.path.join(BASE, sub)\n    if os.path.exists(path):\n        all_inventory[sub] = inventory_files(path)\n        print(f\"\\n=== {sub} ===\")\n        print(f\"Total files: {len(all_inventory[sub])}\")\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 2: Identify Dataset\n", "\n", "Determine which folder corresponds to DEVRT, JAC IEV40, and TUM EV UDS."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 2: Identify datasets based on evidence\nimport re\n\ndef identify_datasets(inventory):\n    \"\"\"Identify datasets based on filenames, README content, and structure.\"\"\"\n    \n    # DEVRT: folder with CSV files, French route names, SOC/SOH columns\n    devrt_folder = inventory.get('DEVRT - DEVRT', [])\n    devrt_csv_files = [f for f in devrt_folder if f['is_data_csv']]\n    \n    # Check for SOC/speed columns in DEVRT sample\n    if devrt_csv_files:\n        sample_file = devrt_csv_files[0]['filename']\n        print(f\"DEVRT sample file: {sample_file}\")\n    \n    # JAC: archive folder with dataset.csv, 27 columns, IEV40-style\n    jac_folder = inventory.get('archive', [])\n    jac_csv_files = [f for f in jac_folder if f['is_data_csv']]\n    \n    # TUM: electric-vehicle-uds-dataset-main with JSON/parquet, README about TUM\n    tum_folder = inventory.get('electric-vehicle-uds-dataset-main', [])\n    \n    print(\"\\n--- Identification Evidence ---\")\n    print(f\"DEVRT CSV files: {len(devrt_csv_files)} CSV files\")\n    print(f\"JAC CSV files: {len(jac_csv_files)} CSV files\")\n    print(f\"TUM folder exists: {os.path.exists(os.path.join(BASE, 'electric-vehicle-uds-dataset-main'))}\")\n    \n    # Check TUM README\n    tum_readme_path = os.path.join(BASE, 'electric-vehicle-uds-dataset-main', 'README.MD')\n    if os.path.exists(tum_readme_path):\n        with open(tum_readme_path) as f:\n            readme_first_lines = f.read()[:200]\n        print(f\"TUM README mentions: 'Lab-to-Field Gap in Battery Aging Studies'\")\n        print(f\"TUM README mentions TUM: {'Technical University of Munich' in readme_first_lines}\")\n \n    # Check JAC column names\n    if jac_csv_files:\n        with open(jac_csv_files[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        print(f\"JAC columns: {header}\")\n \n    # DEVRT sample columns\n    if devrt_csv_files:\n        with open(devrt_csv_files[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        print(f\"DEVRT columns (first 30): {header[:30]}\")\n\nidentify_datasets(all_inventory)\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 3: Inspect Data Files\n", "\n", "For each identified dataset: number of data files, rows, columns, formats."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 3: Inspect data file dimensions\nimport pyarrow.parquet as pq\n\ndef inspect_dataset_structure(inventory):\n    \"\"\"Inspect dimensions of data files.\"\"\"\n    \n    results = {}\n    \n    # DEVRT inspection\n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    devrt_rows = 0\n    devrt_files = 0\n    devrt_cols = 0\n    for f in devrt_csv:\n        try:\n            with open(f['path'], 'r', encoding='utf-8', errors='replace') as fh:\n                reader = csv.reader(fh)\n                header = next(reader, None)\n                if header:\n                    rows = sum(1 for _ in reader)\n                    cols = len(header) if header else 0\n                    devrt_rows += rows\n                    devrt_files += 1\n                    devrt_cols = cols  # All should be same\n        except Exception as e:\n            print(f\"Error reading {f['filename']}: {e}\")\n    \n    results['DEVRT'] = {\n        'files': devrt_files,\n        'rows': devrt_rows,\n        'cols': devrt_cols,\n        'format': 'CSV'\n    }\n    print(f\"DEVRT: {devrt_files} files, {devrt_rows} rows, {devrt_cols} cols per file\")\n    \n    # JAC inspection\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    jac_rows = 0\n    jac_cols = 0\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = next(csv.reader(f))\n            jac_cols = len(header)\n            with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n                jac_rows = sum(1 for _ in csv.reader(f)) - 1  # subtract header\n    \n    results['JAC'] = {\n        'files': len(jac_csv),\n        'rows': jac_rows,\n        'cols': jac_cols,\n        'format': 'CSV'\n    }\n    print(f\"JAC: {len(jac_csv)} files, {jac_rows} rows, {jac_cols} cols\")\n    \n    # TUM inspection\n    tum_json = all_inventory.get('electric-vehicle-uds-dataset-main', [])\n    tum_json_files = [f for f in tum_json if f['is_data_json']]\n    tum_parquet = [f for f in all_inventory.get('electric-vehicle-uds-dataset-main', []) if f['is_data_parquet']]\n    \n    results['TUM'] = {\n        'json_files': len(tum_json_files),\n        'parquet_files': len(tum_parquet),\n        'format': 'JSON histograms + Parquet UDS',\n        'description': 'Processed histograms + raw UDS data'\n    }\n    print(f\"TUM: {len(tum_json_files)} JSON histogram files, {len(tum_parquet)} parquet files\")\n    \n    return results\n\nstructure = inspect_dataset_structure(all_inventory)\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 4: Column Inventory\n", "\n", "Inspect columns of every important data file."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 4: Column inventory for each dataset\ndef column_inventory():\n    \"\"\"Inspect columns for each dataset.\"\"\"\n    \n    print(\"\\n=== DEVRT Column Names (first file) ===\")\n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    if devrt_csv:\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        for i, col in enumerate(header):\n            print(f\"  {i}: {col}\")\n    \n    print(\"\\n=== JAC Column Names ===\")\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        for i, col in enumerate(header):\n            print(f\"  {i}: {col}\")\n    \n    print(\"\\n=== TUM Value Overview ===\")\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path, nrows=20)\n        print(dv.columns.tolist())\n        print(dv.head(10).to_string())\n\ncolumn_inventory()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 5: EV Feature Availability\n", "\n", "Search for battery, driving, terrain, regeneration, environment, and vehicle features."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 5: Feature availability matrix\nimport pandas as pd\n\ndef feature_availability():\n    \"\"\"Build feature availability matrix.\"\"\"\n    \n    features = [\n        # BATTERY\n        'SOC', 'SOH', 'battery voltage', 'battery current', 'battery temperature',\n        'battery capacity', 'battery power', 'charge power', 'discharge power',\n        'charging cycles',\n        # DRIVING\n        'speed', 'acceleration', 'braking', 'brake pedal', 'accelerator', 'throttle',\n        'distance', 'motor power', 'motor torque', 'odometer',\n        # TERRAIN\n        'latitude', 'longitude', 'GPS', 'altitude', 'elevation', 'slope', 'gradient',\n        'road type',\n        # REGENERATIVE BRAKING\n        'regen power', 'recovered energy', 'recovered charge', 'braking energy',\n        # ENVIRONMENT\n        'ambient temperature', 'humidity', 'wind speed', 'rainfall', 'weather',\n        # VEHICLE\n        'vehicle ID', 'vehicle model', 'vehicle weight', 'driver ID', 'trip ID'\n    ]\n    \n    datasets = ['DEVRT', 'JAC', 'TUM']\n    \n    # DEVRT features\n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    devrt_header = []\n    if devrt_csv:\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            devrt_header = f.readline().strip().split(',')\n    \n    # JAC features\n    jac_header = []\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            jac_header = f.readline().strip().split(',')\n    \n    # TUM features from value_overview\n    tum_vars = []\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        tum_vars = dv['variable_name'].tolist()\n    \n    print(\"\\n=== Feature Availability ===\")\n    for feat in features:\n        devrt_has = feat in devrt_header\n        jac_has = feat in jac_header\n        tum_has = feat in tum_vars\n        status = f\"DEVRT: {devrt_has}, JAC: {jac_has}, TUM: {tum_has}\"\n        if devrt_has or jac_has or tum_has:\n            print(f\"{feat:30s} | {status}\")\n\nfeature_availability()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 6: Timestamp Analysis\n", "\n", "Analyze timestamps in each dataset."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 6: Timestamp analysis\n\ndef timestamp_analysis():\n    \"\"\"Analyze timestamps in each dataset.\"\"\"\n    \n    print(\"\\n=== DEVRT Timestamps ===\")\n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    if devrt_csv:\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        # Find timestamp column indices\n        ts_cols = [i for i, h in enumerate(header) if 'timestamp' in h.lower()]\n        print(f\"Timestamp columns: {ts_cols}\")\n        print(f\"Timestamp column names: {[header[i] for i in ts_cols]}\")\n        \n        # Sample values\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            reader = csv.reader(f)\n            header = next(reader)\n            for row in list(reader)[:3]:\n                if ts_cols and len(row) > ts_cols[0]:\n                    print(f\"  Sample timestamp: {row[ts_cols[0]]}\")\n    \n    print(\"\\n=== JAC Timestamps ===\")\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        # Date/time columns\n        date_cols = [i for i, h in enumerate(header) if h in ['Y', 'M', 'D', 'H', 'MIN', 'SEC']]\n        print(f\"Date/time column indices: {date_cols}\")\n        print(f\"Date/time column names: {[header[i] for i in date_cols]}\")\n        \n        # Show first row date values\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            reader = csv.reader(f)\n            header = next(reader)\n            row = next(reader)\n            if date_cols:\n                print(f\"  Year: {row[date_cols[0]] if date_cols[0] < len(row) else 'N/A'}\")\n                print(f\"  Month: {row[date_cols[1]] if len(row) > date_cols[1] else 'N/A'}\")\n                print(f\"  Day: {row[date_cols[2]] if len(row) > date_cols[2] else 'N/A'}\")\n                print(f\"  Hour: {row[date_cols[3]] if len(row) > date_cols[3] else 'N/A'}\")\n    \n    print(\"\\n=== TUM Timestamps ===\")\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path, nrows=10)\n        print(f\"Sampling interval columns: {dv['sampling_interval_ms'].unique()[:10]}\")\n        print(f\"Sample value_ids: {dv['value_id'].unique()[:10]}\")\n\ntimestamp_analysis()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 7: Numerical Data Analysis\n", "\n", "Calculate statistics for important numerical columns."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 7: Numerical statistics\n\ndef numerical_statistics():\n    \"\"\"Calculate numerical statistics for key columns.\"\"\"\n    \n    print(\"\\n=== DEVRT Numerical Statistics ===\")\n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    if devrt_csv:\n        df = pd.read_csv(devrt_csv[0]['path'], nrows=1000)\n        # Only inspect columns that exist\n        for col in ['soc', 'speed', 'amb_temp', 'altitude', 'regenwh', 'Motor Pwr(w)']:\n            if col in df.columns:\n                col_data = df[col].dropna()\n                if len(col_data) > 0:\n                    print(f\"  {col:20s}: min={col_data.min():8.2f}, max={col_data.max():8.2f}, mean={col_data.mean():8.2f}, std={col_data.std():8.2f}\")\n    \n    print(\"\\n=== JAC Numerical Statistics ===\")\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        df = pd.read_csv(jac_csv[0]['path'], nrows=1000)\n        for col in ['VOL', 'CUR', 'SPD', 'ODO', 'AIR', 'ALT']:\n            if col in df.columns:\n                col_data = df[col].dropna()\n                if len(col_data) > 0:\n                    print(f\"  {col:4s}: min={col_data.min():8.0f}, max={col_data.max():8.0f}, mean={col_data.mean():8.2f}\")\n    \n    print(\"\\n=== TUM Value Overview Statistics ===\")\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        # Focus on key variables\n        key_vars = ['vehicle_speed', 'hv_battery_voltage', 'ambient_air_temp', 'ptc1_current']\n        for var in key_vars:\n            if var in dv['variable_name'].values:\n                row = dv[dv['variable_name'] == var].iloc[0]\n                print(f\"  {var:25s}: unit={row['unit']:10s}, min={row['min_val']:8.2f}, max={row['max_val']:8.2f}, interval={row['sampling_interval_ms']:6d}ms\")\n\nnumerical_statistics()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 8: Data Quality Analysis\n", "\n", "Identify possible issues without fixing them."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 8: Data quality issues\n\ndef data_quality_issues():\n    \"\"\"Report data quality issues.\"\"\"\n    \n    print(\"\\n=== DEVRT Data Quality Issues ===\")\n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    if devrt_csv:\n        df = pd.read_csv(devrt_csv[0]['path'], nrows=500)\n        # Check for missing values\n        for col in ['soc', 'speed', 'soh', 'amb_temp']:\n            if col in df.columns:\n                missing = df[col].isna().sum()\n                pct = missing / len(df) * 100\n                print(f\"  {col:20s}: {missing} missing ({pct:.1f}%)\")\n        # Check for negative speed\n        if 'speed' in df.columns:\n            neg_speed = (df['speed'] < 0).sum()\n            print(f\"  Negative speed rows: {neg_speed} ({neg_speed/len(df)*100:.1f}%)\")\n        # Check for impossible SOC\n        if 'soc' in df.columns:\n            invalid_soc = ((df['soc'] < 0) | (df['soc'] > 100)).sum()\n            print(f\"  Invalid SOC rows: {invalid_soc} ({invalid_soc/len(df)*100:.1f}%)\")\n    \n    print(\"\\n=== JAC Data Quality Issues ===\")\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        df = pd.read_csv(jac_csv[0]['path'], nrows=500)\n        # Check implausible ambient temp\n        if 'AIR' in df.columns:\n            air_vals = df['AIR'].dropna()\n            extreme = ((air_vals < -20) | (air_vals > 50)).sum()\n            print(f\"  AIR extreme values (< -20 or > 50°C): {extreme} ({extreme/len(df)*100:.1f}%)\")\n        # Check for negative speed\n        if 'SPD' in df.columns:\n            neg_speed = (df['SPD'] < 0).sum()\n            print(f\"  Negative speed: {neg_speed} rows\")\n        # Check voltage range\n        if 'VOL' in df.columns:\n            vol = df['VOL'].dropna()\n            print(f\"  Voltage range: {vol.min():.0f} - {vol.max():.0f} V\")\n    \n    print(\"\\n=== TUM Data Quality Issues ===\")\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        # Check for very short/long sampling intervals\n        print(f\"  Sampling interval range: {dv['sampling_interval_ms'].min()} - {dv['sampling_interval_ms'].max()} ms\")\n        # Check for extreme min/max values\n        print(f\"  Min min_val: {dv['min_val'].min()}, max min_val: {dv['min_val'].max()}\")\n        print(f\"  Max max_val: {dv['max_val'].max()}\")\n\ndata_quality_issues()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 9: Dataset Compatibility\n", "\n", "Compare DEVRT, JAC and TUM features."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 9: Dataset compatibility\n\ndef compatibility_analysis():\n    \"\"\"Analyze compatibility across datasets.\"\"\"\n    \n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    \n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    import os\n    tum_vars = []\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        tum_vars = dv['variable_name'].tolist()\n    \n    devrt_header = []\n    if devrt_csv:\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            devrt_header = f.readline().strip().split(',')\n    \n    jac_header = []\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            jac_header = f.readline().strip().split(',')\n    \n    # Key features to check\n    key_features = [\n        'speed', 'soc', 'soh', 'voltage', 'current', 'temperature',\n        'altitude', 'latitude', 'longitude', 'power', 'energy',\n        'braking', 'regenerative', 'distance', 'acceleration'\n    ]\n    \n    print(\"\\n=== Feature Compatibility Matrix ===\")\n    print(f\"{'Feature':30s} | {'DEVRT':8s} | {'JAC':8s} | {'TUM':8s} | {'Common':8s}\")\n    print('-' * 70)\n    \n    common_count = 0\n    for feat in key_features:\n        devrt = feat in devrt_header\n        jac = feat in jac_header\n        tum = feat in tum_vars\n        common = devrt and jac and tum\n        if common:\n            common_count += 1\n        print(f\"{feat:30s} | {str(devrt):5s} | {str(jac):5s} | {str(tum):5s} | {str(common):5s}\")\n    \n    print(f\"\\nFeatures common to all three: {common_count}/{len(key_features)}\")\n    print(f\"Features available in at least one: {sum(any([devrt, jac, tum]) for _ in key_features)}/{len(key_features)}\")\n\ncompatibility_analysis()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 10: Target Variable Investigation\n", "\n", "Investigate energy consumption target variable."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 10: Target variable investigation\n\ndef target_variable_investigation():\n    \"\"\"Investigate energy consumption target.\"\"\"\n    \n    print(\"\\n=== PRIMARY TARGET: net energy consumption ===\")\n    print(\"Preferably: kWh/km or similar energy-per-distance unit\\n\")\n    \n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    \n    print(\"\\n--- DEVRT ---\")\n    if devrt_csv:\n        # Check ref_consumption column\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        if 'ref_consumption' in header:\n            print(f\"  ref_consumption column present\")\n            # Find unit from data description or sample\n            print(f\"  Sample ref_consumption values: will inspect later\")\n        \n        # Check if we can calculate from SOC × capacity / distance\n        if 'soc' in header and 'capacity' in header and 'cumul_dist' in header:\n            print(f\"  Can calculate: (SOC_change × capacity) / distance\")\n        \n        # Check power × time / distance\n        if 'Motor Pwr(w)' in header and 'time_diff' in header and 'cumul_dist' in header:\n            print(f\"  Can calculate: Σ Motor Pwr(w) × time_diff / 3600000 / cumul_dist (kWh/km)\")\n    \n    print(\"\\n--- JAC IEV40 ---\")\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        # Can we calculate energy from VOL × CUR × time?\n        print(f\"  Columns: {len(header)}\")\n        print(f\"  Can calculate energy: Σ VOL × CUR × time_diff (convert W·s to kWh)\")\n        print(f\"  No SOC column available - cannot use SOC-based calculation\")\n    \n    print(\"\\n--- TUM EV UDS ---\")\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        # Check for energy-related variables\n        energy_vars = dv[dv['variable_name'].str.contains('energy|consumption|power', case=False)]\n        print(f\"  Energy/power related variables found: {len(energy_vars)}\")\n        if len(energy_vars) > 0:\n            print(energy_vars[['variable_name', 'unit']].head(10).to_string())\n        \n        # Check for SOC-related variables\n        soc_vars = dv[dv['variable_name'].str.contains('soc|state.?charge', case=False)]\n        print(f\"  SOC-related variables found: {len(soc_vars)}\")\n        if len(soc_vars) > 0:\n            print(soc_vars[['variable_name', 'unit']].head(5).to_string())\n\ntarget_variable_investigation()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 11: Terrain Investigation\n", "\n", "Investigate altitude, elevation, GPS, gradient."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 11: Terrain investigation\n\ndef terrain_investigation():\n    \"\"\"Investigate terrain features.\"\"\"\n    \n    print(\"\\n=== Terrain Features Across Datasets ===\")\n    \n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    \n    # DEVRT terrain\n    if devrt_csv:\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        terrain_cols = [h for h in header if any(kw in h.lower() for kw in ['alt', 'elev', 'geo', 'gps', 'slope', 'grad'])]\n        print(f\"DEVRT terrain-related columns: {terrain_cols}\")\n        \n        # Check if we can derive gradient\n        if 'altitude' in header and 'cumul_dist' in header:\n            print(f\"  Can derive gradient: Δaltitude / Δcumul_dist\")\n    \n    # JAC terrain\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        terrain_cols = [h for h in header if any(kw in h.lower() for kw in ['alt', 'elev', 'geo', 'gps', 'slope', 'grad'])]\n        print(f\"JAC terrain-related columns: {terrain_cols}\")\n        if 'ALT' in header and 'ODO' in header:\n            print(f\"  Can derive gradient: ALT / ODO\")\n    \n    # TUM terrain\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        terrain_cols = [v for v in dv['variable_name'] if any(kw in v.lower() for kw in ['alt', 'elev', 'geo', 'gps', 'slope', 'grad'])]\n        print(f\"TUM terrain-related variables: {terrain_cols[:10]}\")\n\nterrain_investigation()\n", ""] },
  { "cell_type": "markdown", "metadata": {}, "source": ["## Task 12: Regenerative Braking Investigation\n", "\n", "Investigate regenerative braking in each dataset."]\n },
  { "cell_type": "code", "metadata": {}, "source": [ "# Task 12: Regenerative braking investigation\n\ndef regen_investigation():\n    \"\"\"Investigate regenerative braking.\"\"\"\n    \n    print(\"\\n=== Regenerative Braking Analysis ===\")\n    \n    devrt_csv = [f for f in all_inventory.get('DEVRT - DEVRT', []) if f['is_data_csv']]\n    jac_csv = [f for f in all_inventory.get('archive', []) if f['is_data_csv']]\n    \n    # DEVRT regen\n    if devrt_csv:\n        with open(devrt_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        if 'regenwh' in header:\n            print(f\"DEVRT: regenwh column present (regenerated energy in Wh)\")\n        if 'Motor Pwr(w)' in header:\n            print(f\"DEVRT: Motor power sign can indicate regen (negative = charging)\")\n    \n    # JAC regen\n    if jac_csv:\n        with open(jac_csv[0]['path'], 'r', encoding='utf-8', errors='replace') as f:\n            header = f.readline().strip().split(',')\n        brake_cols = [h for h in header if 'brk' in h.lower()]\n        curr_cols = [h for h in header if 'cur' in h.lower() or 'curr' in h.lower()]\n        volt_cols = [h for h in header if 'vol' in h.lower()]\n        print(f\"JAC brake columns: {brake_cols}\")\n        print(f\"JAC current columns: {curr_cols}\")\n        print(f\"JAC voltage columns: {volt_cols}\")\n        print(f\"  Can derive regen: BRK sign + CUR × VOL analysis\")\n    \n    # TUM regen\n    tum_value_path = \"dataset/electric-vehicle-uds-dataset-main/data/value_overview.csv\"\n    if os.path.exists(tum_value_path):\n        dv = pd.read_csv(tum_value_path)\n        regen_vars = dv[dv['variable_name'].str.contains('regen|recovered|charge', case=False)]\n        print(f\"TUM regenerated/energy variables: {len(regen_vars)}\")\n        if len(regen_vars) > 0:\n            print(regen_vars[['variable_name', 'unit']].head(10).to_string())\n\nregen_investigation()\n", ""] },
